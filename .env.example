# Copy to `.env` and fill in. Never commit `.env`.

# --- SEC EDGAR (required for ingestion) --------------------------------------------------
# SEC fair-access policy requires a descriptive User-Agent with a contact email.
FINSIGHT_SEC__USER_AGENT="Your Name your.email@example.com"

# --- Anthropic (only for --llm claude: generation, agent, LLM judge) ----------------------
# The SDK reads this itself; it is intentionally NOT part of the Settings object.
# Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# --- Ollama (free, local: --llm ollama - no key needed) ------------------------------------
# `brew install ollama && brew services start ollama && ollama pull llama3.2:3b`, then e.g.
#   finsight ask "What was Apple's revenue in fiscal 2024?" --llm ollama --system agent
# `finsight doctor` checks reachability and whether the configured model is pulled.
# FINSIGHT_OLLAMA__BASE_URL=http://localhost:11434
# FINSIGHT_OLLAMA__MODEL=llama3.2:3b
# FINSIGHT_OLLAMA__CONTEXT_TOKENS=8192

# --- finsight serve / finsight ui: which LLM answers `mode=agent` --------------------------
# 'auto' (default) = Claude if ANTHROPIC_API_KEY exists, else router-only - never Ollama
# automatically, so the free path is always an explicit choice, never a fallback. Equivalent to
# `finsight serve --llm ollama`, which sets this for you.
# FINSIGHT_LLM_PROVIDER=ollama

# --- docker compose: free Ollama path + host port overrides --------------------------------
# Ollama runs on the HOST (not in the compose stack); the container reaches it through Docker
# Desktop's host alias, not `localhost`. Verified working (see docker-compose.yml header comment):
# FINSIGHT_LLM_PROVIDER=ollama
# FINSIGHT_OLLAMA__BASE_URL=http://host.docker.internal:11434
#
# If 8000/6333/8501 are already taken by something else on the host, `docker compose up` fails
# fast with "port is already allocated" rather than silently picking another one - move the
# affected port(s) here and retry (only the host side changes; containers still talk to each
# other on the original ports):
# FINSIGHT_API_PORT=8000
# FINSIGHT_QDRANT_PORT=6333
# FINSIGHT_UI_PORT=8501

# --- Optional overrides (every setting can be overridden; nested groups use "__") ---------
# FINSIGHT_ENV=dev
# FINSIGHT_LOG_LEVEL=INFO
# FINSIGHT_LOG_JSON=false
# FINSIGHT_LLM__MODEL=claude-opus-5
# FINSIGHT_LLM__JUDGE_MODEL=claude-opus-5
# FINSIGHT_RETRIEVAL__MODE=hybrid
# FINSIGHT_RETRIEVAL__FINAL_K=8
# FINSIGHT_EMBEDDING__MODEL_NAME=BAAI/bge-small-en-v1.5
# FINSIGHT_QDRANT_URL=http://localhost:6333   # use a Qdrant server instead of embedded storage (docker compose sets this)
