{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["-m", "not network and not llm and not slow"],
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": { "source.fixAll.ruff": "explicit", "source.organizeImports.ruff": "explicit" }
  },
  "files.exclude": { "**/__pycache__": true, "**/.mypy_cache": true, "**/.ruff_cache": true },
  "search.exclude": { "data": true, "reports/runs": true, ".venv": true }
}
